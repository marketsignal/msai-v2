{
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true
  },
  "permissions": {
    "allow": [
      "Read",
      "Edit",
      "Write",
      "Edit(./.claude/local/**)",
      "Edit(**/.claude/local/**)",
      "Bash",
      "Bash(codex:*)",
      "Bash(rm -rf .mypy_cache)",
      "Bash(rm -rf .pytest_cache)",
      "Bash(rm -rf .ruff_cache)",
      "Skill",
      "WebFetch",
      "WebSearch",
      "Monitor",
      "mcp__context7",
      "mcp__playwright",
      "Edit(./.forge/local/**)",
      "Edit(**/.forge/local/**)"
    ],
    "deny": [
      "Bash(rm -rf /:*)",
      "Bash(rm -rf ~:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(chmod 777:*)",
      "Bash(dd:*)",
      "Bash(mkfs:*)",
      "Write(~/.forge/bin/**)",
      "Write(~/.forge/goal-captures/**)",
      "Write(~/.forge/goal-authorizations/**)",
      "Write(~/.forge/host-contexts/**)",
      "Edit(**/.git/forge-goals/**)",
      "Bash(*forge-goals*:*)"
    ],
    "ask": [
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(npm publish:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(gh issue close:*)",
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl patch:*)",
      "Bash(curl -X POST:*)",
      "Bash(curl -X PUT:*)",
      "Bash(curl -X PATCH:*)",
      "Bash(curl -X DELETE:*)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "forgeManagedId": "host-context",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.forge/hooks/lib/host-context.sh\" hook --host claude"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.forge/hooks/session-start.sh",
            "forgeManagedId": "session-start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.forge/hooks/build-evidence.sh",
            "forgeManagedId": "build-evidence"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.forge/hooks/check-state-updated.sh",
            "forgeManagedId": "state-updated"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "prompt",
            "model": "sonnet",
            "prompt": "Evaluate the subagent's output quality. Consider:\n1. Did the subagent complete its assigned task?\n2. Is the output useful and actionable?\n3. Were there any errors or issues?\n\nYou MUST respond with ONLY a JSON object in one of these formats:\n{\"ok\": true} - if the subagent completed successfully\n{\"ok\": false, \"reason\": \"explanation of what went wrong\"} - if issues were found\n\nRespond with ONLY the JSON object, no other text."
          }
        ]
      },
      {
        "matcher": "^forge-v6-producer$",
        "hooks": [
          {
            "type": "command",
            "forgeManagedId": "subagent-review-receipt",
            "command": "$CLAUDE_PROJECT_DIR/.forge/hooks/check-subagent-review.sh"
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "echo 'COMPACTION IMMINENT. Save learnings to auto memory: bug root causes, patterns, architecture insights, user preferences. NOT session state (that goes in .claude/local/state.md).' >&2; exit 0",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.forge/hooks/pre-compact-memory.sh",
            "forgeManagedId": "precompact-memory"
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.forge/hooks/check-config-change.sh",
            "forgeManagedId": "config-change"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "forgeManagedId": "external-mutation-auth",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.forge/hooks/check-external-mutation-auth.sh\""
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.forge/hooks/check-bash-safety.sh",
            "forgeManagedId": "bash-safety"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.forge/hooks/check-workflow-gates.sh",
            "forgeManagedId": "workflow-gates"
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.forge/hooks/auto-approve-local-writes.sh",
            "forgeManagedId": "auto-approve-local"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.forge/hooks/post-tool-format.sh",
            "forgeManagedId": "post-format"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "forgeManagedId": "host-context",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.forge/hooks/lib/host-context.sh\" hook --host claude"
          }
        ]
      }
    ]
  }
}
